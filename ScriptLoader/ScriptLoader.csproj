<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(MonoTf)</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>ScriptLoader</AssemblyName>
    <RootNamespace>MelonScriptLoader</RootNamespace>
    <RequiresMelonMono>true</RequiresMelonMono>
    <RequiresMcs>true</RequiresMcs>
    <Description>Compile and hot-reload C# scripts inside a MelonLoader Mono game.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(MelonMonoDir)/MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="mcs">
      <HintPath>$(McsDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
  <Target Name="CopyToGame" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)/Mods" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(McsDll)" DestinationFolder="$(GameDir)/UserLibs" SkipUnchangedFiles="true" />
  </Target>
  -->

</Project>
