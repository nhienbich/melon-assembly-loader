<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Payload</AssemblyName>
    <RequiresUnityInterop>true</RequiresUnityInterop>
    <Description>Sample payload hot-loaded by AssemblyLoader. Entry point is public static void Main().</Description>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(MelonNet6)/MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(InteropRuntime)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(Il2CppMscorlib)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityCoreModule)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
  <Target Name="CopyToAssemblyFolder" AfterTargets="Build">
    <MakeDir Directories="$(GameDir)/UserData/assembly" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)/UserData/assembly" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(GameDir)/UserData/assembly" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>
  -->

</Project>
