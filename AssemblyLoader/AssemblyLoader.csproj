<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <AssemblyName>AssemblyLoader</AssemblyName>
    <RootNamespace>MelonAssemblyLoader</RootNamespace>
    <Description>Hot-load a C# payload into a MelonLoader IL2CPP game without restarting.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(MelonNet6)/MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
  <Target Name="CopyToMods" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)/Mods" SkipUnchangedFiles="true" />
  </Target>
  -->

</Project>
